@model Gym_Management_System.Models.GymClass

@{
    ViewData["Title"] = "Gym Class Details";
}

<h1>Gym Class Details</h1>

<div class="card">
    <div class="card-body">

        <h3>@Model.Name</h3>

        <p>
            <strong>ID:</strong>
            @Model.Id
        </p>

        <p>
            <strong>Description:</strong>
            @Model.Description
        </p>

        <p>
            <strong>Schedule:</strong>
            @Model.Schedule
        </p>

        <p>
            <strong>Trainer:</strong>
            @Model.Trainer?.Name
        </p>

        <p>
            <strong>Trainer Email:</strong>
            @Model.Trainer?.Email
        </p>
         <!-- Admin Only -->
        @if (User.IsInRole("Admin"))
             {

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Edit
        </a>
            }
        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>


    </div>
    <a asp-controller="Member"
       asp-action="MembersByGymClass"
       asp-route-id="@Model.Id"
       class="btn btn-secondary btn-sm">
        Members
    </a>
</div>
