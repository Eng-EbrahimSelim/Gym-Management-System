<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Gym_Management_System</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Gym_Management_System.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- Logo -->
                <a class="navbar-brand"
                   asp-controller="GymClass"
                   asp-action="Index">
                    Gym Management
                </a>

                <!-- Mobile Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Navigation Links -->
                    <ul class="navbar-nav flex-grow-1">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Gym Classes -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="GymClass"
                                   asp-action="Index">
                                    Gym Classes
                                </a>
                            </li>

                            <!-- Admin Only -->
                            @if (User.IsInRole("Admin"))
                            {
                                <!-- Members -->
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Member"
                                       asp-action="Index">
                                        Members
                                    </a>
                                </li>

                                <!-- Trainers -->
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Trainer"
                                       asp-action="Index">
                                        Trainers
                                    </a>
                                </li>
                            }
                        }

                    </ul>


                    <!-- Right Side -->
                    <ul class="navbar-nav">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Username -->
                            <li class="nav-item">
                                <span class="nav-link text-dark">
                                    Welcome, @User.Identity.Name
                                </span>
                            </li>

                            <!-- Logout -->
                            <li class="nav-item">
                                <a class="nav-link text-danger"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>

        </nav>
    </header>


    <!-- Page Content -->
    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- Footer -->
    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - Gym Management System

        </div>

    </footer>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>