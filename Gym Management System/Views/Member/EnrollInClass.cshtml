@model Gym_Management_System.Models.Enrollment

@{
    ViewData["Title"] = "Enroll Member In Class";
}

<div class="row justify-content-center">

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-header">
                <h3 class="mb-0">Enroll Member In Class</h3>
            </div>

            <div class="card-body">

                <form asp-action="EnrollInClass" method="post">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <!-- Member -->
                    <div class="mb-3">

                        <label asp-for="MemberId"
                               class="form-label">
                            Member
                        </label>

                        <select asp-for="MemberId"
                                asp-items="ViewBag.Members"
                                class="form-select">

                            <option value="">
                                -- Select Member --
                            </option>

                        </select>

                        <span asp-validation-for="MemberId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Gym Class -->
                    <div class="mb-3">

                        <label asp-for="GymClassId"
                               class="form-label">
                            Gym Class
                        </label>

                        <select asp-for="GymClassId"
                                asp-items="ViewBag.GymClasses"
                                class="form-select">

                            <option value="">
                                -- Select Gym Class --
                            </option>

                        </select>

                        <span asp-validation-for="GymClassId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Enrollment Date -->
                    <div class="mb-3">

                        <label asp-for="EnrollmentDate"
                               class="form-label">
                            Enrollment Date
                        </label>

                        <input asp-for="EnrollmentDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="EnrollmentDate"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="d-flex justify-content-between">

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Enroll Member
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}